PYTHON

from openai import OpenAI

client =3D OpenAI
( =C2=A0=C2=A0base_url=3D"https://openrouter.ai/api/v1",
=C2=A0=C2=A0api_key=3D"YOUR_API_KEY" )


response =3D client.chat.completions.create
